{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valuables Vault",
  "mainBinaryName": "valuables-vault",
  "version": "../package.json",
  "identifier": "com.medtec24.valuablesvault",
  "build": {
    "frontendDist": "../dist/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Valuables Vault",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src 'self' blob: data:; media-src blob: mediastream:; connect-src ipc: http://ipc.localhost blob: data: https://api.github.com; worker-src blob:; font-src 'self' data:",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Ing.-Büro Sachit Shrestha",
    "copyright": "© 2026 Ing.-Büro Sachit Shrestha · support@medtec24.com",
    "category": "Finance",
    "shortDescription": "Secure offline inventory for valuables, safes and bank lockers",
    "longDescription": "Valuables Vault documents gold, jewellery, art, documents and everything in your safe or bank locker: one encrypted record per item with photos, invoices, certificates, valuations, ownership, storage location, witness verification and insurance analysis. Everything is encrypted (AES-256) and stays on your device.",
    "homepage": "https://github.com/sachitss/vault",
    "license": "LicenseRef-Proprietary",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German",
          "Nepali"
        ],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "Nepali": "nsis/Tauri-Nepali.nsh"
        }
      },
      "wix": {
        "language": [
          "en-US",
          "de-DE"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "section": "utils"
      },
      "rpm": {
        "release": "1"
      }
    },
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzMDJFQjNFMEIyMjRCNDcKUldSSFN5SUxQdXNDQXlzTkZQOFFiRTdPQUx2WGw0Q0czV25XZTBGc1NIWFVWRG5qanF3YUVFNHYK",
      "endpoints": [
        "https://github.com/sachitss/vault/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
